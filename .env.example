# Copy to .env and adjust for your environment.
# SQLite file used by the app, migrations and the demo seed.
# Can be an absolute path, a relative path, or a file:// URL.
# Leave unset to default to ./data/app.db inside the project.
DATABASE_URL=

# Secret used to sign session cookies (set to a long random value in production).
SESSION_SECRET=vidyasetu-sih-demo-secret

# ---------------------------------------------------------------------------
# AI Doubt Solver (floating Pragyan Sahayak chatbot).
# Leave DOUBT_AI_PROVIDER empty (or "none") to run the built-in offline NCERT
# answer engine — no internet or API key needed. Set the values below to plug
# in a real LLM; it is used first and the offline engine takes over on failure.
# DOUBT_AI_PROVIDER=openai        # openai | gemini | none
# DOUBT_AI_API_KEY=
# DOUBT_AI_MODEL=gpt-4o-mini      # gemini-2.0-flash for gemini
# DOUBT_AI_BASE_URL=              # optional, for any OpenAI-compatible API


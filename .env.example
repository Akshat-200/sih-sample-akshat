# Copy to .env and adjust for your environment.
# SQLite file used by the app, migrations and the demo seed.
# Can be an absolute path, a relative path, or a file:// URL.
# Leave unset to default to ./data/app.db inside the project.
DATABASE_URL=

# Secret used to sign session cookies (set to a long random value in production).
SESSION_SECRET=vidyasetu-sih-demo-secret

# ---------------------------------------------------------------------------
# Pragyan Sahayak — the AI chat assistant (floating chatbot).
# Powered by Google Gemini: students can ask about anything and the model
# answers in its own language. Get a free key at https://aistudio.google.com
#
# Gemini quick start:
#   DOUBT_AI_PROVIDER=gemini
#   DOUBT_AI_API_KEY=<your Gemini API key from aistudio.google.com>
#   DOUBT_AI_MODEL=gemini-2.5-flash
#
# DOUBT_AI_PROVIDER=gemini        # gemini (default) | openai (any OpenAI-compatible API)
# DOUBT_AI_API_KEY=               # alias: GEMINI_API_KEY is also accepted
# DOUBT_AI_MODEL=gemini-2.5-flash # alias: GEMINI_MODEL; e.g. gpt-4o-mini for openai
# DOUBT_AI_BASE_URL=              # optional, for any OpenAI-compatible API
#
# Model safety net: if the configured model fails (e.g. an outdated name like
# "gemini-pro" now returns HTTP 404), the bot automatically retries with
# gemini-2.5-flash, gemini-2.5-flash-lite, gemini-flash-latest, gemini-2.0-flash,
# then gemini-2.5-pro.

# Browser-side fallback for the chat widget: used only when the server path is
# unreachable (e.g. hosted preview whose server cannot reach Google). The chat
# then calls Gemini directly from the student's browser.
# NOTE: NEXT_PUBLIC_* variables ARE visible in the browser bundle — leave these
# unset in production if you only want the secure server-side path.
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash